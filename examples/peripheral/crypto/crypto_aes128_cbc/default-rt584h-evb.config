
#
# -------- SDK   Configuration --------
#
# CONFIG_RT581 is not set
# CONFIG_RT582 is not set
# CONFIG_RT583 is not set
CONFIG_RT584H=y
# CONFIG_RF1301 is not set
# CONFIG_RT584L is not set
# CONFIG_RT582_NONE_OS is not set
# CONFIG_RT584_NONE_OS is not set
CONFIG_CHIP="RT584H"
CONFIG_CPU_COMPILER_FLAG="-mcpu=cortex-m33"
CONFIG_FREERTOS=y
CONFIG_HOSAL=y
CONFIG_DRIVER=y
CONFIG_CRYPTO=y
# CONFIG_HELLOWORLD is not set
CONFIG_BASIC_EXAMPLE=y
# CONFIG_BLUETOOTH_LE_EXAMPLE is not set
# CONFIG_THREAD_EXAMPLE is not set
# CONFIG_SUBG_EXAMPLE is not set
# CONFIG_ZIGBEE_EXAMPLE is not set
# CONFIG_HCI_RAW is not set
# CONFIG_MULTI_PROTOCOL_RCP is not set
# CONFIG_RF_EV_UB is not set
# CONFIG_RF_LABTEST_TOOL is not set

#
# Basic Examples
#
# CONFIG_PERIPHERAL_EXAMPLE_AUX is not set
# CONFIG_PERIPHERAL_EXAMPLE_BOD is not set
CONFIG_PERIPHERAL_EXAMPLE_CRYPTO=y
# CONFIG_PERIPHERAL_EXAMPLE_DMA is not set
# CONFIG_PERIPHERAL_EXAMPLE_FLASH is not set
# CONFIG_PERIPHERAL_EXAMPLE_GPIO is not set
# CONFIG_PERIPHERAL_EXAMPLE_I2C is not set
# CONFIG_PERIPHERAL_EXAMPLE_I2S is not set
# CONFIG_PERIPHERAL_EXAMPLE_IRM is not set
# CONFIG_PERIPHERAL_EXAMPLE_LPM is not set
# CONFIG_PERIPHERAL_EXAMPLE_PWM is not set
# CONFIG_PERIPHERAL_EXAMPLE_QSPI is not set
# CONFIG_PERIPHERAL_EXAMPLE_RTC is not set
# CONFIG_PERIPHERAL_EXAMPLE_SADC is not set
# CONFIG_PERIPHERAL_EXAMPLE_SWI is not set
# CONFIG_PERIPHERAL_EXAMPLE_SLOW_TIMER is not set
# CONFIG_PERIPHERAL_EXAMPLE_TIMER is not set
# CONFIG_PERIPHERAL_EXAMPLE_UART is not set
# CONFIG_PERIPHERAL_EXAMPLE_WDT is not set
# CONFIG_PERIPHERAL_EXAMPLE_OTP is not set
CONFIG_PER_CRYPTO_AES128_CBC=y
# CONFIG_PER_CRYPTO_AES128_CTR is not set
# CONFIG_PER_CRYPTO_AES128_DECRYPT is not set
# CONFIG_PER_CRYPTO_AES128_ENCRYPT is not set
# CONFIG_PER_CRYPTO_AES192_CTR is not set
# CONFIG_PER_CRYPTO_AES256_DECRYPT is not set
# CONFIG_PER_CRYPTO_AES256_ENCRYPT is not set
# CONFIG_PER_CRYPTO_CCM is not set
# CONFIG_PER_CRYPTO_CTR_DRBG is not set
# CONFIG_PER_CRYPTO_CURVE_C25519_1 is not set
# CONFIG_PER_CRYPTO_CURVE_C25519_2 is not set
# CONFIG_PER_CRYPTO_ECC_GF2M_BL163_1 is not set
# CONFIG_PER_CRYPTO_ECC_GF2M_BL163_2 is not set
# CONFIG_PER_CRYPTO_ECC_GFP_192 is not set
# CONFIG_PER_CRYPTO_ECC_GFP_192_ECDH is not set
# CONFIG_PER_CRYPTO_ECC_GFP_256_ECDH is not set
# CONFIG_PER_CRYPTO_ECDSA is not set
# CONFIG_PER_CRYPTO_ECJPAKE is not set
# CONFIG_PER_CRYPTO_HMAC is not set
# CONFIG_PER_CRYPTO_HKDF is not set
# CONFIG_PER_CRYPTO_HMAC_DRBG is not set
# CONFIG_PER_CRYPTO_PBKDF2 is not set
# CONFIG_PER_CRYPTO_ECC_GFP_256 is not set
# CONFIG_PER_CRYPTO_ECC_GFP_256_ADD is not set
# CONFIG_PER_CRYPTO_MISC is not set
# CONFIG_PER_CRYPTO_SM2 is not set
# CONFIG_PER_CRYPTO_SM3 is not set
# CONFIG_PER_CRYPTO_SM4 is not set
# end of Basic Examples

CONFIG_CRYPTO_AES_ENABLE=y
CONFIG_CRYPTO_C25519_ENABLE=y
CONFIG_CRYPTO_SECP256R1_ENABLE=y
CONFIG_CRYPTO_SECP192R1_ENABLE=y
CONFIG_CRYPTO_SECT163R2_ENABLE=y
CONFIG_CRYPTO_SM3_ENABLE=y
CONFIG_CRYPTO_SM4_ENABLE=y
CONFIG_CRYPTO_SM2P256V1_ENABLE=y
CONFIG_CRYPTO_SM2_P192_ENABLE=y
# CONFIG_BOOTLOADER_APP is not set

#
# Select Board type and Peripheral
#
CONFIG_EVB=y
# CONFIG_DONGLE is not set
CONFIG_BOARD="EVB"
CONFIG_HOSAL_SOC_MAIN_ENTRY_TASK_SIZE=256
CONFIG_HOSAL_SOC_MAIN_ENTRY_TASK_PRIORITY=5
# CONFIG_HOSAL_SOC_IDLE_SLEEP is not set
CONFIG_HOSAL_SOC_TARGET_CUSTOMER=""

#
# RT584 EVB
#
# end of RT584 EVB

CONFIG_TRUST_ZONE_SECURE=y
CONFIG_TRUST_ZONE="TRUST_ZONE_SECURE"

#
# Peripheral Securiy
#
CONFIG_AUX_COMP_SECURE_EN=y
CONFIG_BOD_COMP_SECURE_EN=y
CONFIG_COMM_SUBSYSTEM_AHB_SECURE_EN=y
CONFIG_DMA0_SECURE_EN=y
CONFIG_DMA1_SECURE_EN=y
CONFIG_DPD_SECURE_EN=y
CONFIG_FLASHCTRL_SECURE_EN=y
CONFIG_GPIO_SECURE_EN=y
CONFIG_I2C_MASTER0_SECURE_EN=y
CONFIG_I2C_MASTER1_SECURE_EN=y
CONFIG_I2C_SLAVE_SECURE_EN=y
CONFIG_I2S0_SECURE_EN=y
CONFIG_IRM_SECURE_EN=y
CONFIG_PWM_SECURE_EN=y
CONFIG_QSPI0_SECURE_EN=y
CONFIG_QSPI1_SECURE_EN=y
CONFIG_RCO1M_CAL_SECURE_EN=y
CONFIG_RCO32K_CAL_SECURE_EN=y
CONFIG_RTC_SECURE_EN=y
CONFIG_SADC_SECURE_EN=y
CONFIG_SLOWTIMER0_SECURE_EN=y
CONFIG_SLOWTIMER1_SECURE_EN=y
CONFIG_SOC_PMU_SECURE_EN=y
CONFIG_SWI0_SECURE_EN=y
CONFIG_SWI1_SECURE_EN=y
CONFIG_SYSCTRL_SECURE_EN=y
CONFIG_TIMER0_SECURE_EN=y
CONFIG_TIMER1_SECURE_EN=y
CONFIG_TIMER2_SECURE_EN=y
CONFIG_UART0_SECURE_EN=y
CONFIG_UART1_SECURE_EN=y
CONFIG_UART2_SECURE_EN=y
CONFIG_WDT_SECURE_EN=y
CONFIG_XDMA_SECURE_EN=y
# end of Peripheral Securiy

#
# Peripheral
#
CONFIG_PERIPHERAL_DMA=y
# CONFIG_PERIPHERAL_PWM is not set
# CONFIG_PERIPHERAL_I2S is not set
# CONFIG_PERIPHERAL_I2C is not set
# CONFIG_PERIPHERAL_SPI is not set
# CONFIG_PERIPHERAL_SADC is not set
# CONFIG_PERIPHERAL_RTC is not set
# CONFIG_PERIPHERAL_TIMER is not set
# CONFIG_PERIPHERAL_SWI is not set
# CONFIG_PERIPHERAL_AUX_COMP is not set
# CONFIG_PERIPHERAL_BOD_COMP is not set
# CONFIG_PERIPHERAL_IRM is not set
# CONFIG_RCO32K_ENABLE is not set
# CONFIG_RCO16K_ENABLE is not set
# CONFIG_RCO20K_ENABLE is not set
# end of Peripheral
# end of Select Board type and Peripheral

#
# Select CPC Component
#
# CONFIG_BUILD_COMPONENT_CPC is not set
# end of Select CPC Component

#
# Select Network RF Component
#
# CONFIG_BUILD_COMPONENT_CSS is not set
CONFIG_BUILD_COMPONENT_RUCI=y
# CONFIG_BUILD_COMPONENT_LMAC5P4 is not set
CONFIG_BUILD_COMPONENT_RT569=y
CONFIG_RF_POWER_0DBM=y
# CONFIG_RF_POWER_20DBM is not set
CONFIG_BUILD_COMPONENT_RT569_RF=y
CONFIG_BUILD_COMPONENT_RT569_FW=y
CONFIG_TEMP_VOL_COMP_PERIOD=1
# end of Select Network RF Component

#
# Select Supported FW Images
#
# CONFIG_RF_FW_INCLUDE_PCI is not set
# CONFIG_RF_FW_INCLUDE_BLE is not set
# CONFIG_RF_FW_INCLUDE_MULTI_2P4G is not set
# CONFIG_RF_FW_INCLUDE_MAC_ACC is not set
# CONFIG_RF_FW_INCLUDE_HYBRID_INST is not set
# CONFIG_RF_FW_INCLUDE_INTERNAL_TEST is not set
# end of Select Supported FW Images

#
# Select Crypto
#
# end of Select Crypto

#
# Select Utility
#
# CONFIG_BUILD_COMPONENT_LOG is not set
CONFIG_BUILD_COMPONENT_UART_STDIO=y
CONFIG_UART_STDIO_PORT=0
CONFIG_UART_STDIO_TX_PIN=17
CONFIG_UART_STDIO_RX_PIN=16
CONFIG_UART_STDIO_BAUDRATE=2000000
CONFIG_BUILD_COMPONENT_UTILITY=y
# CONFIG_BUILD_COMPONENT_CLI is not set
# CONFIG_BUILD_COMPONENT_NEWLIBC is not set
# CONFIG_BUILD_COMPONENT_SYSLOG is not set
# CONFIG_BUILD_COMPONENT_SW_TIMER is not set
# CONFIG_BUILD_COMPONENT_ENHANCED_FLASH_DATASET is not set
# CONFIG_BUILD_COMPONENT_LZMADEC is not set
# CONFIG_BUILD_COMPONENT_VERSION_INFO is not set
# CONFIG_BUILD_COMPONENT_DUMP_BOOT_INFO is not set
# end of Select Utility

CONFIG_BUILD_PORJECT="crypto_aes128_cbc"

#
# Select Compiler Optimization
#
CONFIG_OPT_DEFAULT=y
# CONFIG_OPT_O0 is not set
# CONFIG_OPT_O1 is not set
# CONFIG_OPT_O2 is not set
# CONFIG_OPT_O3 is not set
# CONFIG_OPT_Ofast is not set
# CONFIG_OPT_Og is not set
# CONFIG_OPT_Os is not set
# CONFIG_OPT_Oz is not set
CONFIG_COMPILE_OPTIMIZATION="-O"
CONFIG_CUSTOM_COMPILE_FLAG=""
# end of Select Compiler Optimization
