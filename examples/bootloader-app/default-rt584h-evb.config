
#
# -------- SDK   Configuration --------
#
# CONFIG_RT581 is not set
# CONFIG_RT582 is not set
# CONFIG_RT583 is not set
# CONFIG_RT584H is not set
# CONFIG_RF1301 is not set
# CONFIG_RT584L is not set
# CONFIG_RT582_NONE_OS is not set
CONFIG_RT584H_NONE_OS=y
CONFIG_CHIP="RT584H_NONE_OS"
CONFIG_CPU_COMPILER_FLAG="-mcpu=cortex-m33"
CONFIG_HOSAL=y
CONFIG_DRIVER=y
CONFIG_CRYPTO=y
# CONFIG_HELLOWORLD is not set
# CONFIG_BASIC_EXAMPLE is not set
# CONFIG_BLUETOOTH_LE_EXAMPLE is not set
# CONFIG_THREAD_EXAMPLE is not set
# CONFIG_SUBG_EXAMPLE is not set
# CONFIG_ZIGBEE_EXAMPLE is not set
# CONFIG_HCI_RAW is not set
# CONFIG_MULTI_PROTOCOL_RCP is not set
# CONFIG_RF_EV_UB is not set
# CONFIG_RF_LABTEST_TOOL is not set
CONFIG_CRYPTO_AES_ENABLE=y
CONFIG_CRYPTO_C25519_ENABLE=y
CONFIG_CRYPTO_SECP256R1_ENABLE=y
CONFIG_CRYPTO_SECP192R1_ENABLE=y
CONFIG_CRYPTO_SECT163R2_ENABLE=y
CONFIG_CRYPTO_SM3_ENABLE=y
CONFIG_CRYPTO_SM4_ENABLE=y
CONFIG_CRYPTO_SM2P256V1_ENABLE=y
CONFIG_CRYPTO_SM2_P192_ENABLE=y
CONFIG_BOOTLOADER_APP=y

#
# BOOTLOADER Configuration
#
CONFIG_BOOTLOADER_MAIN_VERSION=1
CONFIG_BOOTLOADER_MINOR_VERSION=0
# CONFIG_BOOTLOADER_DEBUG is not set
CONFIG_HOSAL_SOC_DISABLE_MP_SECTOR_INIT=y
# end of BOOTLOADER Configuration

#
# Select Board type and Peripheral
#
CONFIG_BOOTLOADER=y
CONFIG_BOARD="BOOTLOADER"
CONFIG_TRUST_ZONE_SECURE=y
CONFIG_TRUST_ZONE="TRUST_ZONE_SECURE"

#
# Peripheral Securiy
#
CONFIG_AUX_COMP_SECURE_EN=y
CONFIG_BOD_COMP_SECURE_EN=y
CONFIG_COMM_SUBSYSTEM_AHB_SECURE_EN=y
CONFIG_DMA0_SECURE_EN=y
CONFIG_DMA1_SECURE_EN=y
CONFIG_DPD_SECURE_EN=y
CONFIG_FLASHCTRL_SECURE_EN=y
CONFIG_GPIO_SECURE_EN=y
CONFIG_I2C_MASTER0_SECURE_EN=y
CONFIG_I2C_MASTER1_SECURE_EN=y
CONFIG_I2C_SLAVE_SECURE_EN=y
CONFIG_I2S0_SECURE_EN=y
CONFIG_IRM_SECURE_EN=y
CONFIG_PWM_SECURE_EN=y
CONFIG_QSPI0_SECURE_EN=y
CONFIG_QSPI1_SECURE_EN=y
CONFIG_RCO1M_CAL_SECURE_EN=y
CONFIG_RCO32K_CAL_SECURE_EN=y
CONFIG_RTC_SECURE_EN=y
CONFIG_SADC_SECURE_EN=y
CONFIG_SLOWTIMER0_SECURE_EN=y
CONFIG_SLOWTIMER1_SECURE_EN=y
CONFIG_SOC_PMU_SECURE_EN=y
CONFIG_SWI0_SECURE_EN=y
CONFIG_SWI1_SECURE_EN=y
CONFIG_SYSCTRL_SECURE_EN=y
CONFIG_TIMER0_SECURE_EN=y
CONFIG_TIMER1_SECURE_EN=y
CONFIG_TIMER2_SECURE_EN=y
CONFIG_UART0_SECURE_EN=y
CONFIG_UART1_SECURE_EN=y
CONFIG_UART2_SECURE_EN=y
CONFIG_WDT_SECURE_EN=y
CONFIG_XDMA_SECURE_EN=y
# end of Peripheral Securiy

#
# Peripheral
#
CONFIG_PERIPHERAL_DMA=y
CONFIG_PERIPHERAL_PWM=y
CONFIG_PERIPHERAL_I2S=y
CONFIG_PERIPHERAL_I2C=y
CONFIG_PERIPHERAL_SPI=y
CONFIG_PERIPHERAL_SADC=y
CONFIG_PERIPHERAL_RTC=y
CONFIG_PERIPHERAL_TIMER=y
CONFIG_PERIPHERAL_SWI=y
# end of Peripheral
# end of Select Board type and Peripheral

#
# Select CPC Component
#
# CONFIG_BUILD_COMPONENT_CPC is not set
# end of Select CPC Component

#
# Select Network RF Component
#
# CONFIG_BUILD_COMPONENT_CSS is not set
CONFIG_BUILD_COMPONENT_RUCI=y
# CONFIG_BUILD_COMPONENT_LMAC5P4 is not set
CONFIG_BUILD_COMPONENT_RT569=y
CONFIG_BUILD_COMPONENT_RT569_RF=y
CONFIG_BUILD_COMPONENT_RT569_FW=y
CONFIG_TEMP_VOL_COMP_PERIOD=1
# end of Select Network RF Component

#
# Select Supported FW Images
#
CONFIG_RF_FW_INCLUDE_PCI=y
CONFIG_RF_FW_INCLUDE_BLE=y
CONFIG_RF_FW_INCLUDE_MULTI_2P4G=y
CONFIG_RF_FW_INCLUDE_MAC_ACC=y
CONFIG_RF_FW_INCLUDE_HYBRID_INST=y
CONFIG_RF_FW_INCLUDE_INTERNAL_TEST=y
CONFIG_RF_MCU_CONST_LOAD_SUPPORTED=y
# end of Select Supported FW Images

#
# Select Crypto
#
# end of Select Crypto

#
# Select Utility
#
CONFIG_BUILD_COMPONENT_LOG=y
CONFIG_LOG_MAX_LEVEL=0
CONFIG_BUILD_COMPONENT_UART_STDIO=y
CONFIG_UART_STDIO_PORT=0
CONFIG_UART_STDIO_TX_PIN=17
CONFIG_UART_STDIO_RX_PIN=16
CONFIG_UART_STDIO_BAUDRATE=2000000
CONFIG_BUILD_COMPONENT_UTILITY=y
# CONFIG_BUILD_COMPONENT_CLI is not set
# CONFIG_BUILD_COMPONENT_NEWLIBC is not set
# CONFIG_BUILD_COMPONENT_SYSLOG is not set
# CONFIG_BUILD_COMPONENT_SW_TIMER is not set
# CONFIG_BUILD_COMPONENT_ENHANCED_FLASH_DATASET is not set
CONFIG_BUILD_COMPONENT_LZMADEC=y
CONFIG_BUILD_COMPONENT_VERSION_INFO=y
# end of Select Utility

CONFIG_BUILD_PORJECT="bootloader-app"

#
# Select Compiler Optimization
#
CONFIG_OPT_DEFAULT=y
# CONFIG_OPT_O0 is not set
# CONFIG_OPT_O1 is not set
# CONFIG_OPT_O2 is not set
# CONFIG_OPT_O3 is not set
# CONFIG_OPT_Ofast is not set
# CONFIG_OPT_Og is not set
# CONFIG_OPT_Os is not set
# CONFIG_OPT_Oz is not set
CONFIG_COMPILE_OPTIMIZATION="-O"
CONFIG_CUSTOM_COMPILE_FLAG=""
# end of Select Compiler Optimization
