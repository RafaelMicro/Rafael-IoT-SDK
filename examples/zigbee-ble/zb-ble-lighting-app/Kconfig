menu "PROJECT CONFIG"

menu "TRSP UART Settings"

config APP_TRSP_OPERATION_UART_PORT
    int "TRSP UART PORT"
    default 1
    range 0 2

config APP_TRSP_OPERATION_UART_TX_PIN
    int "TRSP UART Tx PIN"
    default 28
    range 0 32

config APP_TRSP_OPERATION_UART_RX_PIN
    int "TRSP UART Rx PIN"
    default 29
    range 0 32

config APP_TRSP_OPERATION_UART_BAUDRATE
    int "TRSP UART baudrate"
    default 115200

endmenu

endmenu
