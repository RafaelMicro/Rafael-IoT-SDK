
#
# -------- USER SPACE --------
#
# CONFIG_BASIC_EXAMPLE is not set
# CONFIG_BLUETOOTH_LE_EXAMPLE is not set
CONFIG_THREAD_EXAMPLE=y
# CONFIG_OTHERS_EXAMPLE is not set
# CONFIG_OT_CLI_FTD is not set
# CONFIG_OT_CLI_MTD is not set
CONFIG_THREAD_DEMO=y
CONFIG_APP_TASK_STACK_SIZE=2048
CONFIG_APP_TASK_PRIORITY=15
CONFIG_APP_RF_BAND_2_4G=y
# CONFIG_APP_RF_BAND_SUBG is not set

#
# Thread demo configurations
#
# CONFIG_APP_DEVICE_TYPE_FTD is not set
CONFIG_APP_DEVICE_TYPE_MTD=y

#
# Thread network configurations
#
CONFIG_APP_THREAD_NETWORK_NAME="Thread-Demo"
CONFIG_APP_THREAD_NETWORK_PANID=2222
CONFIG_APP_THREAD_NETWORK_CHANNEL=26
CONFIG_APP_THRREAD_NETWORK_MASTER_KEY="00112233445566778899aabbccddeeff"
CONFIG_APP_THREAD_NETWORK_DATA_POLL_PERIOD=2000
CONFIG_APP_THREAD_NETWORK_CHILD_TIMEOUT=60
CONFIG_APP_THREAD_CHANNEL_SCAN_RETRY=2
CONFIG_APP_THREAD_CHANNEL_SCAN_TIMEOUT=2000
CONFIG_APP_THREAD_LONG_DEEPSLEEP_WAKEUP_TIME=30
CONFIG_APP_THREAD_SHORT_DEEPSLEEP_WAKEUP_TIME=5
CONFIG_APP_THREAD_UDP_LISTEN_PORT=10010
CONFIG_APP_THREAD_CHANNEL_SCAN_NUMBER=5
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL01=11
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL02=12
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL03=13
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL04=14
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL05=15
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL06=16
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL07=17
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL08=18
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL09=19
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL10=20
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL11=21
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL12=22
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL13=23
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL14=24
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL15=25
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL16=26
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL17=0
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL18=0
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL19=0
CONFIG_APP_THREAD_CHANNEL_SCAN_CHANNEL20=0
# end of Thread network configurations

CONFIG_APP_IDLE_SLEEP=y
# end of Thread demo configurations

CONFIG_BUILD_PORJECT="thread-demo"

#
# PROJECT CONFIG
#
CONFIG_HOSAL_SOC_MAIN_ENTRY_TASK_SIZE=256
# end of PROJECT CONFIG

#
# SELECT DEVICE
#
# CONFIG_RT581 is not set
# CONFIG_RT582_NONE_OS is not set
CONFIG_RT582=y
# CONFIG_RT583 is not set
# CONFIG_RT584 is not set
CONFIG_CHIP="RT582"
CONFIG_EVB=y
# CONFIG_DONGLE is not set
CONFIG_BOARD="EVB"

#
# EVK Board Config
#
CONFIG_HOSAL_SOC_MAIN_ENTRY_TASK_PRIORITY=5
# CONFIG_HOSAL_SOC_DISABLE_MP_SECTOR_INIT is not set
CONFIG_HOSAL_SOC_IDLE_SLEEP=y
CONFIG_HOSAL_SOC_SLEEP_TIMER_ID=4
CONFIG_HOSAL_SOC_TARGET_CUSTOMER=""
# end of EVK Board Config

CONFIG_CPU_COMPILER_FLAG="-mcpu=cortex-m3"
CONFIG_FREERTOS=y
CONFIG_DRIVER=y
CONFIG_CRYPTO=y
CONFIG_HOSAL=y
# end of SELECT DEVICE

#
# SELECT COMPONENT
#
# CONFIG_BUILD_COMPONENT_CPC is not set
# CONFIG_BUILD_COMPONENT_BLUETOOTH is not set
CONFIG_BUILD_COMPONENT_LMAC5P4=y
CONFIG_BUILD_COMPONENT_RT569=y
CONFIG_BUILD_COMPONENT_RT569_RF=y
CONFIG_BUILD_COMPONENT_RT569_FW=y
CONFIG_TEMP_VOL_COMP_PERIOD=1
# CONFIG_BUILD_COMPONENT_CSS is not set
CONFIG_BUILD_COMPONENT_RUCI=y
# CONFIG_BUILD_COMPONENT_SUBG_CTRL is not set

#
# THREAD
#
CONFIG_BUILD_COMPONENT_OPENTHREAD=y
# CONFIG_BUILD_COMPONENT_OPENTHREAD_SUBG is not set
CONFIG_BUILD_COMPONENT_OPENTHREAD_PORT=y
# end of THREAD

# CONFIG_BUILD_COMPONENT_ZIGBEE is not set
CONFIG_BUILD_COMPONENT_UTILITY=y
CONFIG_BUILD_COMPONENT_CLI=y
CONFIG_BUILD_COMPONENT_ENHANCED_FLASH_DATASET=y
CONFIG_BUILD_COMPONENT_NEWLIBC=y
CONFIG_BUILD_COMPONENT_LOG=y
CONFIG_BUILD_COMPONENT_UART_STDIO=y
# CONFIG_BUILD_COMPONENT_SYSLOG is not set
# CONFIG_BUILD_COMPONENT_SW_TIMER is not set
# CONFIG_BUILD_COMPONENT_LZMADEC is not set
# CONFIG_BUILD_COMPONENT_VERSION_INFO is not set
# end of SELECT COMPONENT

#
# -------- KERNEL SPACE --------
#

#
# COMPILIER SETTING
#
# CONFIG_OPT_DEFAULT is not set
# CONFIG_OPT_O is not set
# CONFIG_OPT_O0 is not set
# CONFIG_OPT_O1 is not set
# CONFIG_OPT_O2 is not set
# CONFIG_OPT_O3 is not set
# CONFIG_OPT_Ofast is not set
# CONFIG_OPT_Og is not set
CONFIG_OPT_Os=y
# CONFIG_OPT_Oz is not set
CONFIG_COMPILE_OPTIMIZATION="-Os"
CONFIG_CUSTOM_COMPILE_FLAG=""
# end of COMPILIER SETTING

#
# COMPONENT SETTING
#

#
# NETWORK
#

#
# Select Supported FW Images
#
CONFIG_RF_FW_INCLUDE_PCI=y
# CONFIG_RF_FW_INCLUDE_BLE is not set
# CONFIG_RF_FW_INCLUDE_MULTI_2P4G is not set
# CONFIG_RF_FW_INCLUDE_MAC_ACC is not set
# CONFIG_RF_FW_INCLUDE_HYBRID_INST is not set
# CONFIG_RF_FW_INCLUDE_INTERNAL_TEST is not set
# end of Select Supported FW Images

#
# THREAD
#
CONFIG_RADIO_2P4GHZ_OQPSK_SUPPORT=y
CONFIG_OPENTHREAD_TASK_SIZE=4096

#
# OT DEVICE ROLE
#
# CONFIG_OT_DEVICE_TYPE_FTD is not set
CONFIG_OT_DEVICE_TYPE_MTD=y
# CONFIG_OT_DEVICE_TYPE_RCP is not set
# end of OT DEVICE ROLE
# end of THREAD
# end of NETWORK

#
# PLATFROM
#

#
# UTLITY
#

#
# UART Console
#
CONFIG_UART_STDIO_PORT=0
CONFIG_UART_STDIO_TX_PIN=17
CONFIG_UART_STDIO_RX_PIN=16
CONFIG_UART_STDIO_BAUDRATE=115200
# end of UART Console

#
# Sofware timer
#
# CONFIG_SW_TIMER_ENABLE_DEBUG is not set
# end of Sofware timer

CONFIG_LOG_MAX_LEVEL=2
# end of UTLITY
# end of COMPONENT SETTING

#
# PERIPERHAL SLEECT
#
CONFIG_PERIPHERAL_DMA=y
CONFIG_PERIPHERAL_PWM=y
CONFIG_PERIPHERAL_I2S=y
CONFIG_PERIPHERAL_I2C=y
CONFIG_PERIPHERAL_SPI=y
CONFIG_PERIPHERAL_SADC=y
CONFIG_PERIPHERAL_RTC=y
CONFIG_PERIPHERAL_TIMER=y
CONFIG_PERIPHERAL_SWI=y
CONFIG_PERIPHERAL_COMP=y
# end of PERIPERHAL SLEECT

