menu "TFLM (TensorFlow Lite Micro) Examples"

choice
    prompt "Select TFLM Example"
    default TFLM_EX_HELLO_WORLD

config TFLM_EX_HELLO_WORLD
    bool "hello_world (sine regression, int8)"
    select TFLM
    select BUILD_COMPONENT_LOG
    select BUILD_COMPONENT_UART_STDIO
    select BUILD_COMPONENT_UTILITY

endchoice

if TFLM_EX_HELLO_WORLD
source "examples/tflm/hello_world/Kconfig"
endif

endmenu
