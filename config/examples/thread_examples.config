choice 
    prompt "Select Example"
    default OT_CLI_FTD

    config OT_CLI_FTD
    bool "ot-cli-ftd"

    config OT_CLI_MTD
    bool "ot-cli-mtd-sleep"

    config OT_CLI_NCP
    bool "ot-cli-ncp"
endchoice

if OT_CLI_FTD
source "examples/thread/ot-cli-ftd/Kconfig"
endif

if OT_CLI_MTD
source "examples/thread/ot-cli-mtd-sleep/Kconfig"
endif

if OT_CLI_NCP
source "examples/thread/ot-cli-ncp/Kconfig"
endif

