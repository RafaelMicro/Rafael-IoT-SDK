menu "CMSIS-DSP Examples"

choice
    prompt "Select CMSIS-DSP Example"
    default DSP_EX_FFT_BIN

config DSP_EX_FFT_BIN
    bool "arm_fft_bin_example"
    select CMSIS_DSP
    select BUILD_COMPONENT_LOG
    select BUILD_COMPONENT_UART_STDIO
    select BUILD_COMPONENT_UTILITY

config DSP_EX_FIR
    bool "arm_fir_example"
    select CMSIS_DSP
    select BUILD_COMPONENT_LOG
    select BUILD_COMPONENT_UART_STDIO
    select BUILD_COMPONENT_UTILITY

config DSP_EX_MATRIX
    bool "arm_matrix_example"
    select CMSIS_DSP
    select BUILD_COMPONENT_LOG
    select BUILD_COMPONENT_UART_STDIO
    select BUILD_COMPONENT_UTILITY

config DSP_EX_CONVOLUTION
    bool "arm_convolution_example"
    select CMSIS_DSP
    select BUILD_COMPONENT_LOG
    select BUILD_COMPONENT_UART_STDIO
    select BUILD_COMPONENT_UTILITY

config DSP_EX_DOTPRODUCT
    bool "arm_dotproduct_example"
    select CMSIS_DSP
    select BUILD_COMPONENT_LOG
    select BUILD_COMPONENT_UART_STDIO
    select BUILD_COMPONENT_UTILITY

config DSP_EX_VARIANCE
    bool "arm_variance_example"
    select CMSIS_DSP
    select BUILD_COMPONENT_LOG
    select BUILD_COMPONENT_UART_STDIO
    select BUILD_COMPONENT_UTILITY

config DSP_EX_SIN_COS
    bool "arm_sin_cos_example"
    select CMSIS_DSP
    select BUILD_COMPONENT_LOG
    select BUILD_COMPONENT_UART_STDIO
    select BUILD_COMPONENT_UTILITY

config DSP_EX_CLASS_MARKS
    bool "arm_class_marks_example"
    select CMSIS_DSP
    select BUILD_COMPONENT_LOG
    select BUILD_COMPONENT_UART_STDIO
    select BUILD_COMPONENT_UTILITY

config DSP_EX_LINEAR_INTERP
    bool "arm_linear_interp_example"
    select CMSIS_DSP
    select BUILD_COMPONENT_LOG
    select BUILD_COMPONENT_UART_STDIO
    select BUILD_COMPONENT_UTILITY

config DSP_EX_SIGNAL_CONVERGE
    bool "arm_signal_converge_example"
    select CMSIS_DSP
    select BUILD_COMPONENT_LOG
    select BUILD_COMPONENT_UART_STDIO
    select BUILD_COMPONENT_UTILITY

config DSP_EX_BAYES
    bool "arm_bayes_example"
    select CMSIS_DSP
    select BUILD_COMPONENT_LOG
    select BUILD_COMPONENT_UART_STDIO
    select BUILD_COMPONENT_UTILITY

config DSP_EX_SVM
    bool "arm_svm_example"
    select CMSIS_DSP
    select BUILD_COMPONENT_LOG
    select BUILD_COMPONENT_UART_STDIO
    select BUILD_COMPONENT_UTILITY

config DSP_EX_GRAPHIC_EQ
    bool "arm_graphic_equalizer_example"
    select CMSIS_DSP
    select BUILD_COMPONENT_LOG
    select BUILD_COMPONENT_UART_STDIO
    select BUILD_COMPONENT_UTILITY

endchoice

if DSP_EX_FFT_BIN
source "examples/dsp/arm_fft_bin_example/Kconfig"
endif
if DSP_EX_FIR
source "examples/dsp/arm_fir_example/Kconfig"
endif
if DSP_EX_MATRIX
source "examples/dsp/arm_matrix_example/Kconfig"
endif
if DSP_EX_CONVOLUTION
source "examples/dsp/arm_convolution_example/Kconfig"
endif
if DSP_EX_DOTPRODUCT
source "examples/dsp/arm_dotproduct_example/Kconfig"
endif
if DSP_EX_VARIANCE
source "examples/dsp/arm_variance_example/Kconfig"
endif
if DSP_EX_SIN_COS
source "examples/dsp/arm_sin_cos_example/Kconfig"
endif
if DSP_EX_CLASS_MARKS
source "examples/dsp/arm_class_marks_example/Kconfig"
endif
if DSP_EX_LINEAR_INTERP
source "examples/dsp/arm_linear_interp_example/Kconfig"
endif
if DSP_EX_SIGNAL_CONVERGE
source "examples/dsp/arm_signal_converge_example/Kconfig"
endif
if DSP_EX_BAYES
source "examples/dsp/arm_bayes_example/Kconfig"
endif
if DSP_EX_SVM
source "examples/dsp/arm_svm_example/Kconfig"
endif
if DSP_EX_GRAPHIC_EQ
source "examples/dsp/arm_graphic_equalizer_example/Kconfig"
endif

endmenu
