if (RT581 || RT582 || RT583) && EVB
source "config/components/platform/soc/rt582/rt582_evb/ebv.config"
endif # CHIP_TYPE="RT582" && BOARD_TYPE="EVB"

if (RT581 || RT582 || RT583) && DONGLE
source "config/components/platform/soc/rt582/rt582_dongle/dongle.config"
endif # CHIP_TYPE="RT582" && BOARD_TYPE="DONGLE"

if (RF1301 || RT584H ||  RT584HA4 || RT584L) && EVB
source "config/components/platform/soc/rt584/rt584_evb/ebv.config"
endif # CHIP_TYPE="RT581" && BOARD_TYPE="EVB"

config CMSIS_DSP
	bool "Enable CMSIS-DSP library"
	default n
	help
	  Build and link the ARM CMSIS-DSP library
	  (components/platform/common/CMSIS-DSP). Provides fixed/float math,
	  FFT, FIR/IIR filtering, matrix, statistics, etc. On Cortex-M33 the
	  DSP SIMD + hardware FPU paths are used automatically.

config CMSIS_NN
	bool "Enable CMSIS-NN library"
	default n
	help
	  Build and link the ARM CMSIS-NN library
	  (components/platform/common/CMSIS-NN). Provides quantized (int8/int16)
	  neural-network kernels: convolution, fully-connected, pooling, softmax,
	  activation, LSTM. On Cortex-M33 the DSP SIMD path is used automatically.
	  Self-contained (needs only CMSIS-Core, not CMSIS-DSP). Reserved as the
	  optimized backend for a future TFLM integration.

config TFLM
	bool "Enable TensorFlow Lite for Microcontrollers"
	depends on RT584H || RT584HA4 || RT584L || RF1301 || RT584H_NONE_OS || RT584L_NONE_OS || RT584HA4_NONE_OS || RF1301_NONE_OS
	select CMSIS_NN
	default n
	help
	  Build and link TensorFlow Lite for Microcontrollers
	  (thirdparty/tflite-micro): C++ int8/int16 quantized model inference.
	  Uses CMSIS-NN as the optimized kernel backend on Cortex-M33 (the vendored
	  CMSIS-NN v7.0.0 is reused, so this selects CMSIS_NN). Cortex-M33 only
	  (RT584 family); too heavy for the Cortex-M3 parts.
